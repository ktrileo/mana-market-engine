# ==========================================================
# Mana Market Engine - Environment Variables Template
# Copy this file to '.env' inside the infrastructure/ folder
# ==========================================================

# TimescaleDB / PostgreSQL Configuration
POSTGRES_USER=mana_user
POSTGRES_PASSWORD=mana_password
POSTGRES_DB=mana_market

# Connection Strings
DB_DSN=postgres://mana_user:mana_password@localhost:5432/mana_market
REDIS_URL=redis://localhost:6379/0

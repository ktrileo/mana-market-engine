# ==========================================================
# Mana Market Engine - Environment Variables Template
# Copy this file to '.env' inside the infrastructure/ folder
# ==========================================================

# Discord Bot Credentials
# Obtain from https://discord.com/developers/applications -> General Information
DISCORD_PUBLIC_KEY=your_64_character_hex_public_key_here
DISCORD_APPLICATION_ID=your_application_id_here
DISCORD_BOT_TOKEN=your_bot_token_here

# Optional: Specific Guild ID for instant slash command development
DISCORD_GUILD_ID=
